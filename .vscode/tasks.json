{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto Push on Save",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\auto-push.ps1"
